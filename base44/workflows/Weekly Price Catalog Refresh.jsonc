{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_supermarket_price_update",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "refreshPriceCatalog",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Prepare shared price catalog",
            "description": "Check retailer sources in advance (Mon\u2013Sat, 05:00 Berlin)"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 5 * * 1-6",
      "one_time_date": null,
      "timezone": "Europe/Berlin",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "At 05:00 Berlin time, prepare up to 40 source-confirmed product prices for all shoppers to reuse. Price searches do not run while a grocery list is generating. Fresh catalog entries are reused for seven days.",
  "name": "Daily Supermarket Price Update",
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "refreshPriceCatalog"
  }
}