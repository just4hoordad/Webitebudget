  "name": "Daily Supermarket Price Update",
  "description": "Daily price update across all German supermarkets (Aldi, Lidl, Kaufland, Penny, Netto, REWE, Edeka, Norma, dm, Rossmann) every morning at 05:00 Berlin time when stores update their prices, automatically skipping Sundays and German public holidays.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_supermarket_price_update",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
