{
  "description": "Daily price checker \u2014 refreshes the community PriceEstimate database with fresh web prices for stale products/regions.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_price_refresh",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "refresh_prices": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "refreshPriceEstimates",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Refresh community prices",
            "description": "Re-search stale prices via web"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 5 * * *",
      "one_time_date": null,
      "timezone": "Europe/Berlin",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Daily Price Refresh",
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "refreshPriceCatalog"
  }
}