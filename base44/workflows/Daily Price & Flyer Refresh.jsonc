{
  "name": "Daily Price Refresh",
  "description": "Daily price refresh: rebuilds the shared price catalog of source-confirmed product prices for German supermarkets. Runs every day at 05:00 Europe/Berlin.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 5 * * *",
      "one_time_date": null,
      "timezone": "Europe/Berlin",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_price_refresh",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "refresh_catalog": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "refreshPriceCatalog",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Refresh shared price catalog",
            "description": "Rebuild source-confirmed product prices for all shoppers"
          }
        }
      }
    ]
  }
}