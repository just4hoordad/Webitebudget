{
  "name": "MealPlan",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "diet": {
      "type": "string"
    },
    "budget": {
      "type": "number"
    },
    "calories": {
      "type": "number"
    },
    "people": {
      "type": "number"
    },
    "stores": {
      "type": "string"
    },
    "macros": {
      "type": "object",
      "properties": {
        "protein": {
          "type": "number"
        },
        "carbs": {
          "type": "number"
        },
        "fats": {
          "type": "number"
        }
      }
    },
    "plan": {
      "type": [
        "object",
        "array"
      ]
    },
    "groceryList": {
      "type": "object"
    },
    "prep": {
      "type": "object"
    }
  },
  "required": [
    "name",
    "plan"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}