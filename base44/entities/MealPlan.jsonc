{
  "name": "MealPlan",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "diet": {
      "type": "string"
    },
    "budget": {
      "type": "number"
    },
    "calories": {
      "type": "number"
    },
    "people": {
      "type": "number"
    },
    "stores": {
      "type": "string"
    },
    "plan": {
      "type": "object"
    }
  },
  "required": [
    "name",
    "plan"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}