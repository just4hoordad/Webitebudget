{
  "name": "MealPlan",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "diet": {
      "type": "string"
    },
    "budget": {
      "type": "number"
    },
    "calories": {
      "type": "number"
    },
    "people": {
      "type": "number"
    },
    "stores": {
      "type": "string"
    },
    "days": {
      "type": "number",
      "description": "Plan duration in days"
    },
    "postalCode": {
      "type": "string",
      "description": "Postal code used for regional prices"
    },
    "macros": {
      "type": "object",
      "properties": {
        "protein": {
          "type": "number"
        },
        "carbs": {
          "type": "number"
        },
        "fats": {
          "type": "number"
        }
      }
    },
    "plan": {
      "type": [
        "object",
        "array"
      ]
    },
    "groceryList": {
      "type": "object"
    },
    "prep": {
      "type": "object"
    },
    "recipes": {
      "type": "object",
      "description": "Cached on-demand cooking recipes keyed by meal signature (weekIndex:dayIndex:mealType). Each value holds the mealName and the generated recipe so re-opening a meal shows the cached recipe without a new LLM call."
    },
    "lockedMeals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Meal signatures (weekIndex:dayIndex:mealType) the user pinned so 'Regenerate remaining' skips them."
    },
    "cookingDays": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Day signatures (weekIndex:dayIndex) the user marked as cook days (vs. rest/leftover days)."
    },
    "shareToken": {
      "type": "string",
      "description": "Unique public share token. When set, the plan is readable via the public share route (getSharedPlan). Empty/absent means not shared."
    },
    "sharedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the current share token was created."
    }
  },
  "required": [
    "name",
    "plan"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}