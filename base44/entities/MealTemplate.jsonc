{
  "name": "MealTemplate",
  "type": "object",
  "properties": {
    "diet": {
      "type": "string",
      "description": "Diet type e.g. balanced, vegan, keto, frozen"
    },
    "calories": {
      "type": "number",
      "description": "Target daily calories (bucketed, e.g. 1500, 2000, 2500)"
    },
    "people": {
      "type": "number",
      "description": "Number of people"
    },
    "days": {
      "type": "number",
      "description": "Number of days the plan covers"
    },
    "budget_category": {
      "type": "string",
      "description": "low | medium | high"
    },
    "language_code": {
      "type": "string",
      "description": "Language code e.g. en, de, fr"
    },
    "plan_data": {
      "type": "object",
      "description": "Full weeks/days JSON plan object"
    },
    "plan_type": {
      "type": "string",
      "description": "exact | repeat | unique"
    },
    "use_count": {
      "type": "number",
      "description": "How many times this template has been served to users"
    }
  },
  "required": [
    "diet",
    "calories",
    "plan_data"
  ]
}