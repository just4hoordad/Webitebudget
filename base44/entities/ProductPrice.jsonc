{
  "name": "ProductPrice",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Full branded product name (e.g. 'Ja! Vollmilch 3,5% 1L')"
    },
    "category": {
      "type": "string",
      "description": "English category name (e.g. 'Dairy', 'Vegetables')"
    },
    "store": {
      "type": "string",
      "description": "Store where this price was found (e.g. 'aldi', 'lidl')"
    },
    "price": {
      "type": "number",
      "description": "Current unit price in EUR"
    },
    "normal_price": {
      "type": "number",
      "description": "Typical price at a mid-range supermarket (Rewe/Edeka)"
    },
    "unit": {
      "type": "string",
      "description": "Unit of measure (e.g. '1L', '500g', '10er')"
    },
    "calories_info": {
      "type": "string",
      "description": "Calorie info string (e.g. '~150 kcal/100g')"
    },
    "diet_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Diet tags this product is suitable for (e.g. ['vegan', 'vegetarian', 'balanced'])"
    },
    "last_synced": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp of when this price was last fetched"
    }
  },
  "required": [
    "name",
    "store",
    "price",
    "category"
  ]
}