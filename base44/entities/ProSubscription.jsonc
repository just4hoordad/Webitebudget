{
  "name": "ProSubscription",
  "type": "object",
  "properties": {
    "stripeCustomerId": {
      "type": "string",
      "description": "Stripe customer ID"
    },
    "email": {
      "type": "string",
      "description": "Subscriber email"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether the subscription is currently active"
    },
    "tier": {
      "type": "string",
      "enum": [
        "pro",
        "pro_plus"
      ],
      "default": "pro",
      "description": "Subscription tier: 'pro' (\u20ac3.99/mo, 15 credits) or 'pro_plus' (\u20ac9.99/mo, 30 credits)"
    },
    "creditsRemaining": {
      "type": "number",
      "default": 15,
      "description": "Generations remaining this billing period"
    },
    "periodEnd": {
      "type": "string",
      "format": "date-time",
      "description": "ISO date when the current billing period ends and credits reset"
    },
    "stripeSubscriptionId": {
      "type": "string",
      "description": "Stripe subscription ID"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}