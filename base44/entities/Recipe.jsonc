{
  "name": "Recipe",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Recipe title"
    },
    "mealType": {
      "type": "string",
      "enum": [
        "breakfast",
        "lunch",
        "dinner",
        "snack"
      ],
      "default": "dinner",
      "description": "Which meal slot this recipe fits"
    },
    "diet": {
      "type": "string",
      "enum": [
        "balanced",
        "vegetarian",
        "vegan",
        "high-protein",
        "pescatarian",
        "gluten-free",
        "halal",
        "frozen",
        "custom"
      ],
      "default": "custom",
      "description": "Diet category"
    },
    "servings": {
      "type": "number",
      "default": 2,
      "description": "Number of servings"
    },
    "prepTime": {
      "type": "number",
      "default": 0,
      "description": "Prep time in minutes"
    },
    "cookTime": {
      "type": "number",
      "default": 0,
      "description": "Cook time in minutes"
    },
    "ingredients": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "string"
          }
        }
      },
      "default": [],
      "description": "List of ingredients with quantities"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Ordered cooking steps"
    },
    "notes": {
      "type": "string",
      "description": "Optional cook notes"
    },
    "source": {
      "type": "string",
      "enum": [
        "custom",
        "from_plan",
        "remix"
      ],
      "default": "custom",
      "description": "Where the recipe came from"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}